# =====================================================================
# Portal do Mago: variáveis do SITE (Next.js na Vercel)
# Copie para .env.local (uso local e scripts cli/) e cadastre as mesmas na Vercel
# (Project → Settings → Environment Variables → Production). NUNCA commite .env.local.
# Gere os segredos aleatórios com: npm run secrets
# =====================================================================

# --- Obrigatórias ---------------------------------------------------

# Endereço do worker de tempo real (Cloudflare), sem barra no fim. Sai do `wrangler deploy`.
# Atenção: é lida no BUILD (vai pro navegador). Mudou? Faça redeploy na Vercel.
NEXT_PUBLIC_REALTIME_URL=https://portaldomago-realtime.SEU-SUBDOMINIO.workers.dev

# Postgres com pgvector (Supabase recomendado). Use a URL do pooler em modo "transaction" (porta 6543).
# Supabase → Project Settings → Database → Connection string → "Transaction pooler".
ORACULO_DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@SEU-HOST.pooler.supabase.com:6543/postgres

# Chave da API da Anthropic (Oráculo). console.anthropic.com → API Keys. Defina um limite de gasto mensal lá.
ANTHROPIC_API_KEY=sk-ant-COLE-AQUI

# Segredos aleatórios (npm run secrets)
ORACULO_SESSION_SECRET=GERAR
PORTAL_SESSION_SECRET=GERAR
# MESMO valor do segredo MEMBER_TOKEN_SECRET do worker
PORTAL_MEMBER_TOKEN_SECRET=GERAR

# --- Login de membros por e-mail (necessário para AUTH_MODE both/kiwify) ---

# resend.com → API Keys
RESEND_API_KEY=re_COLE-AQUI
# Remetente de um domínio verificado no Resend (ex.: "Portal do Mago <acesso@seudominio.com.br>").
# Sem domínio verificado o Resend só entrega para o e-mail dono da conta.
PORTAL_EMAIL_FROM=Portal do Mago <acesso@SEU-DOMINIO>

# --- Kiwify (acesso pela compra). Ver docs/KIWIFY.md --------------------
# Token(s) do webhook (lista separada por vírgula)
KIWIFY_WEBHOOK_TOKEN=
# Botão "Sincronizar" / npm run kiwify:sync (API pública da Kiwify)
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
KIWIFY_ACCOUNT_ID=
# IDs dos produtos que dão acesso (vírgulas). Vazio = qualquer produto (webhook); a sync exige isto
# ou KIWIFY_SYNC_ALL_PRODUCTS=1
KIWIFY_PRODUCT_IDS=
KIWIFY_SYNC_ALL_PRODUCTS=
# Data inicial da sync (YYYY-MM-DD). Padrão 2024-01-01
KIWIFY_SYNC_SINCE=

# --- Modo de entrada (ESPELHO das mesmas variáveis do worker; mantenha iguais) ---
# code = código da sala | both = código OU e-mail de membro | kiwify = só membro
AUTH_MODE=code
# Salas que forçam um modo (vírgulas), ex.: KIWIFY_ONLY_ROOMS=teste
KIWIFY_ONLY_ROOMS=
BOTH_ROOMS=

# --- Opcionais (já têm padrão) ---------------------------------------
# E-mails de TESTE que entram como membro sem o código por e-mail (vírgulas). Deixe vazio em produção
# (quem souber um desses e-mails entra sem prova).
PORTAL_TRUSTED_EMAILS=
# Worker visto pelo servidor (padrão = NEXT_PUBLIC_REALTIME_URL)
PORTAL_WORKER_URL=
# Modelo do Oráculo (padrão claude-haiku-5-5)
ANTHROPIC_MODEL=
# Só se a chave da Anthropic for de um workspace específico
ANTHROPIC_WORKSPACE_ID=
# Liga/desliga o Oráculo (padrão true)
CHAT_ENABLED=true
# Disjuntor diário do Oráculo (padrões: US$ 3/dia, 400 mensagens/dia)
DAILY_BUDGET_USD=3
DAILY_MAX_MESSAGES=400
# Limites por pessoa (padrões: 20/dia por IP, 5/min por IP, 20/dia por navegador)
IP_DAILY_LIMIT=20
IP_MINUTE_LIMIT=5
VISITOR_DAILY_LIMIT=20

# --- Só para scripts locais (cli/), não precisam ir pra Vercel ---------
# Transcrever áudio de aulas com Workers AI (npm run course:transcribe)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
